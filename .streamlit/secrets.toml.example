# Salin berkas ini ke .streamlit/secrets.toml dan isi kredensial sendiri.
# .streamlit/secrets.toml sudah di-gitignore, kunci tidak akan pernah ter-commit.
#
# Endpoint apa pun yang kompatibel OpenAI bisa dipakai. Tambah/hapus blok [llm.*]
# bebas — tiap blok jadi satu pilihan model di halaman Chatbot. Nama setelah
# "llm." (mis. "openai" di bawah) hanya id internal, bebas apa saja.
#
# Tanpa blok [llm.*] sama sekali, chatbot menampilkan pesan fallback (lihat
# chat/chatbot.py answer_question) — halaman dashboard lain tetap berfungsi penuh.

# Sumber data. Bila motherduck_token diisi, core/db.py membaca dari MotherDuck
# (database "rekrutmen"); bila dikosongkan/dihapus, ia jatuh ke berkas lokal
# data/rekrutmen.duckdb. Streamlit Community Cloud WAJIB memakai token,
# karena berkas .duckdb 62 MB itu tidak ikut ter-commit.
motherduck_token = ""

[llm.openai]
label = "GPT-5.6 Luna (OpenAI)"
icon = ":material/smart_toy:"
api_key = "sk-YOUR_OPENAI_API_KEY"
base_url = "https://api.openai.com/v1"
model = "gpt-5.6-luna"

[llm.llama4]
label = "Llama 4 Scout"
icon = ":material/robot_2:"
api_key = "YOUR_API_KEY"
base_url = "https://your-provider.example.com/v1"
model = "meta-llama/llama-4-scout"

# Opsional: catatan singkat di bawah badge status, mis. untuk kunci gratis/kedaluwarsa.
# note = "Kunci gratis - kedaluwarsa 2026-08-12"
